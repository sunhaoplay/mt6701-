 215:Core/Src/usart.c **** static void UART_DMA_HandleRxEvent(UART_DMA_RxContext *context, uint16_t length)
 216:Core/Src/usart.c **** {
 217:Core/Src/usart.c ****   uint8_t completed_buffer;
 218:Core/Src/usart.c ****   uint8_t *completed_data;
 219:Core/Src/usart.c **** 
 220:Core/Src/usart.c ****   if (length > context->buffer_size)
 221:Core/Src/usart.c ****   {
 222:Core/Src/usart.c ****     length = context->buffer_size;
 223:Core/Src/usart.c ****   }
 224:Core/Src/usart.c **** 
 225:Core/Src/usart.c ****   completed_buffer = context->active_buffer;
 226:Core/Src/usart.c ****   completed_data = context->buffer[completed_buffer];
 227:Core/Src/usart.c ****   context->message_data = completed_data;
 228:Core/Src/usart.c ****   context->message_length = length;
 229:Core/Src/usart.c **** 
 230:Core/Src/usart.c ****   /* Restart reception first, using the other buffer, then notify the user. */
 231:Core/Src/usart.c ****   context->active_buffer ^= 1U;
 232:Core/Src/usart.c ****   (void)UART_DMA_StartReceive(context);
 233:Core/Src/usart.c **** 
 234:Core/Src/usart.c ****   if (context->uart->Instance == USART3)
 235:Core/Src/usart.c ****   {
 236:Core/Src/usart.c ****     uart3_msg_rev(completed_data, length);
 237:Core/Src/usart.c ****   }
 238:Core/Src/usart.c **** }
